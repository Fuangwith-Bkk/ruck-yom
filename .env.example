# System Configuration
NODE_ENV=development

# Phase 2: Express webhook server listen port. Required.
PORT=3000

TIMEZONE=Asia/Bangkok

# Was hardcoded in app.js; externalized for tunability
TUYA_PULSAR_MAX_RETRIES=50

# Tuya Cloud OpenAPI Credentials
# Phase 2: used by tuyaRestClient.js. Required.
TUYA_BASE_URL=https://openapi-sg.iotbing.com

TUYA_ACCESS_ID=your_tuya_access_id
TUYA_ACCESS_SECRET=your_tuya_access_secret

# Not read by any current code path — used manually (via the Tuya API
# Explorer's "Query Home List") to look up the space_id needed to find
# the scene rule_ids below. Kept scaffolded for a possible future
# auto-discovery feature.
TUYA_SMART_LIFE_UID=your_smart_life_uid

# Tap-to-Run scene rule_id for เฝ้าบ้าน — find via Cloud > API Explorer >
# Scene Linkage Rules > Query Linkage Rules (space_id = your home's id),
# filter type="scene". Optional — เฝ้าบ้าน/ไปพัก hide themselves from the
# menu if unset.
TUYA_ARM_SCENE_ID=your_arm_scene_rule_id

# Same, for ไปพัก.
TUYA_DISARM_SCENE_ID=your_disarm_scene_rule_id

# rule_id of the automation (type="automation" in the same Query Linkage
# Rules list above) that "Arm" enables and "Disarm" disables — used at
# boot to recover houseMode's เฝ้าบ้าน/ไปพัก instead of starting unknown
# after every restart. Optional; depends on this exact automation setup
# existing.
TUYA_ALARM_AUTOMATION_ID=your_alarm_automation_rule_id

# Tuya Pulsar Message Service
TUYA_MQ_URL=wss://mqe-sg.iotbing.com:8285/
TUYA_MQ_ENV=PROD

# LINE Messaging API Credentials
# Role-prefixed rather than flat vars: /switch dr|prod (interactionRouter.js
# /botIdentity.js) hot-swaps which of these credential sets outgoing
# messages use, with no restart — required because LINE doesn't allow two
# bots to be members of the same group chat at once, so exactly one of
# prod/dr is ever really in the group; dev is the local/testing identity
# and is never chat-switchable.
#
# Which set is active at boot. Only the *initial* value — once /switch has
# been used, LINE_ROLE_STATE_FILE below wins on every later restart.
LINE_ACTIVE_ROLE=dev

LINE_DEV_CHANNEL_ACCESS_TOKEN=your_dev_line_channel_access_token
LINE_DEV_CHANNEL_SECRET=your_dev_line_channel_secret
LINE_DEV_GROUP_ID=your_dev_line_group_or_user_id

LINE_PROD_CHANNEL_ACCESS_TOKEN=your_prod_line_channel_access_token
LINE_PROD_CHANNEL_SECRET=your_prod_line_channel_secret
# Optional fallback — normally learned automatically the first time this
# role's bot is seen in the group (see LINE_ROLE_STATE_FILE below).
LINE_PROD_GROUP_ID=

LINE_DR_CHANNEL_ACCESS_TOKEN=your_dr_line_channel_access_token
LINE_DR_CHANNEL_SECRET=your_dr_line_channel_secret
LINE_DR_GROUP_ID=

# Persists which role is active (dev/prod/dr) and each role's learned
# groupId across restarts — same crash-recovery tier as QUIET_STATE_FILE
# below. Optional, defaults to ./line-role-state.json.
LINE_ROLE_STATE_FILE=./line-role-state.json

# Used as {{botName}} in alert templates. Optional, defaults to รักยม.
LINE_BOT_NAME=รักยม

# Event Consolidation
# Door->motion->alarm consolidation window (ms). Optional, defaults to 15000.
EVENT_CORRELATION_WINDOW_MS=15000

# Battery Alerts
# battery_percentage/battery DP value (%) below which a device triggers
# BATTERY_LOW. Optional, defaults to 20.
BATTERY_LOW_THRESHOLD=20

# Daily Summary
# HH:mm, in TIMEZONE. Pushes รายงาน (device status + houseMode/quietMode +
# LINE quota) once a day, bypassing quiet mode. Optional — disabled if unset.
DAILY_REPORT_TIME=08:00

# Existence-only marker persisting whether the daily รายงาน push is
# currently disabled via the /report off (ปิดรายงาน) command — same
# crash-recovery tier as QUIET_STATE_FILE below. Optional, defaults to
# ./report-state.json.
REPORT_STATE_FILE=./report-state.json

# Quiet Mode (เงียบๆหน่อย)
# Crash-recovery marker file (existence-only signal, not real state
# persistence). Optional, defaults to ./quiet-state.json.
QUIET_STATE_FILE=./quiet-state.json

# Logging (rotating file, in addition to console/pm2 output)
# Optional, defaults to ./logs
LOG_DIR=./logs

# Rotate when the active log file hits this size. Optional, defaults to 10M.
LOG_MAX_SIZE=10M

# Keep only the N most recent rotated files. Optional, defaults to 7.
LOG_MAX_FILES=7

# debug|info|error. debug also logs raw Tuya SDK per-message payloads.
# Optional, defaults to info.
LOG_LEVEL=info
